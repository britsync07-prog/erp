# Keep the build context small and reproducible.
# Anything here is invisible to `docker build` — keep the runtime-critical
# paths (prisma/, scripts/, public/, src/, package*.json) OUT of this file.

# dependencies & build output (rebuilt inside the image)
node_modules
.next
out
build
.pnp
.pnp.*
.yarn/*
.pnpm-store

# version control
.git
.gitignore
.github
.gitattributes

# secrets — never copy these into an image layer
.env
.env.*
*.pem
*.key
!.env.example

# logs & debug
dev.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# tests (CI runs these; the runtime image has no reason to ship them)
tests
coverage
.nyc_output

# docs
docs
*.md
!README.md

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev database — production runs on PostgreSQL
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal

# os / editor noise
.DS_Store
Thumbs.db
.idea
.vscode
