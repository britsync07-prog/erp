  @@index([orgId, createdAt])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  orgId      String
  entityType String // CUSTOMER | PRODUCT | ORDER | PO | ...
  entityId   String
  message    String
  actorId    String?
  actorName  String?
  source     String   @default("USER")
  createdAt  DateTime @default(now())

  @@index([orgId, entityType, entityId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String?
  actorName  String?
  action     String // CREATE | UPDATE | DELETE | LOGIN | APPROVE | ...
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  source     String   @default("USER")
  createdAt  DateTime @default(now())

  @@index([orgId, entityType, entityId])
  @@index([orgId, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  fileName   String
  mimeType   String?
  sizeBytes  Int?
  storageKey String // object-storage key (Phase 11); local path in dev
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model Job {
  id        String    @id @default(cuid())
  kind      String // AI_ANALYSIS | EMAIL | REPORT | STOCK_CHECK | ...
  payload   Json?
  status    String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED
  attempts  Int       @default(0)
  runAt     DateTime  @default(now())
  finishedAt DateTime?
  error     String?
}
