}

model GoodsReceiptLine {
  id          String       @id @default(cuid())
  receiptId   String
  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  expectedQty Float
  receivedQty Float
  damagedQty  Float        @default(0)
}

// ─── Finance ────────────────────────────────────────────────────────────────

model Invoice {
  id            String    @id @default(cuid())
  number        String
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId       String?
  order         SalesOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status        String    @default("DRAFT") // DRAFT | ISSUED | PARTIAL | PAID | OVERDUE | VOID
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  subtotalCents Int       @default(0)
  taxCents      Int       @default(0)
  totalCents    Int       @default(0)
  paidCents     Int       @default(0)
  createdById   String?
  createdAt     DateTime  @default(now())

  lines    InvoiceLine[]
  payments Payment[]

  @@unique([number])
  @@index([customerId, status])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  description    String
  quantity       Float
  unitPriceCents Int
