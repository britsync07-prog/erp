}

model StockCountLine {
  id          String     @id @default(cuid())
  countId     String
  count       StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  expectedQty Float
  countedQty  Float?
}

// ─── Sales orders & fulfilment ──────────────────────────────────────────────

model SalesOrder {
  id             String   @id @default(cuid())
  number         String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status         String   @default("DRAFT")
  orderDate      DateTime @default(now())
  requestedDate  DateTime?
  subtotalCents  Int      @default(0)
  discountCents  Int      @default(0)
  taxCents       Int      @default(0)
  totalCents     Int      @default(0)
  costCents      Int      @default(0) // snapshotted cost basis for margin
  paymentTerms   String   @default("30_DAYS")
  paymentStatus  String   @default("UNPAID") // UNPAID | PARTIAL | PAID
  deliveryAddress String? // snapshot of the delivery address at confirm time
  internalNotes  String?
  customerNotes  String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines        SalesOrderLine[]
  fulfilments  Fulfilment[]
  invoices     Invoice[]
  returns      SalesReturn[]

  @@unique([number])
  @@index([customerId, status])
}

model SalesOrderLine {
  id               String     @id @default(cuid())
  orderId          String
  order            SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Float
  unitPriceCents   Int // resolved + snapshotted at confirm; never re-priced
  discountPct      Float      @default(0)
  taxRate          Float      @default(22)
  fulfilledQty     Float      @default(0)
}

model Fulfilment {
  id        String     @id @default(cuid())
  orderId   String
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String     @default("NEW") // NEW | WAITING_FOR_STOCK | READY_TO_PICK | PICKING | READY_TO_DISPATCH | DISPATCHED | DELIVERED
  lines     FulfilmentLine[]
  shipments Shipment[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model FulfilmentLine {
  id           String     @id @default(cuid())
  fulfilmentId String
  fulfilment   Fulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  requiredQty  Float
  pickedQty    Float      @default(0)
}

model Shipment {
  id           String     @id @default(cuid())
  fulfilmentId String
  fulfilment   Fulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)
  carrier      String?
  tracking     String?
  shippedAt    DateTime?
  deliveredAt  DateTime?
}

// Customer returns. RESTOCK lines go back into sellable stock via
// CUSTOMER_RETURN movements; DAMAGED lines are recorded but never re-enter
// stock. Finance (Phase 8) consumes completed returns for credit notes.
model SalesReturn {
  id          String   @id @default(cuid())
  code        String
  orderId     String
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reason      String?
  status      String   @default("COMPLETED")
  createdById String?
  createdAt   DateTime @default(now())
  lines       SalesReturnLine[]

  @@unique([code])
  @@index([orderId])
}

model SalesReturnLine {
  id         String      @id @default(cuid())
  returnId   String
  ret        SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Float // sales units
  condition  String // RESTOCK | DAMAGED
}

// ─── Procurement ────────────────────────────────────────────────────────────

model PurchaseRequirement {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId        String? // originating sales order, if the shortage came from one
  poId           String? // consuming purchase order once converted
  warehouseId    String?
  requiredQty    Float // salesUnit
  reason         String // explainable deterministic calculation breakdown
  status         String   @default("OPEN") // OPEN | ORDERED | CANCELLED
  createdBy      String   @default("SYSTEM") // SYSTEM | USER | AI
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([orderId])
  @@index([poId])
}

// Optimistic-concurrency guard for the check-then-reserve sequence (§29, §42).
// One row per product+warehouse; the confirm transaction bumps `version` and
// aborts when another transaction got there first. Portable across SQLite and
// PostgreSQL (no SELECT … FOR UPDATE needed).
model StockGuard {
  productId   String
  warehouseId String
  version     Int    @default(0)

  @@id([productId, warehouseId])
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  number       String
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status       String   @default("DRAFT")
  expectedDate DateTime?
  subtotalCents Int     @default(0)
  taxCents     Int      @default(0)
  totalCents   Int      @default(0)
  notes        String?
  approvedById String?
  approvedAt   DateTime?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([number])
  @@index([supplierId, status])
}

model PurchaseOrderLine {
  id             String        @id @default(cuid())
  poId           String
  po             PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Float // purchaseUnit
  unitCostCents  Int // per salesUnit
  receivedQty    Float         @default(0) // purchaseUnit
}

model GoodsReceipt {
  id          String        @id @default(cuid())
  code        String
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedById String?
  receivedAt  DateTime      @default(now())
