  zone        String?

  @@unique([warehouseId, code])
}

// Append-only ledger. Physical stock is ALWAYS derived: sum(quantity) grouped
// by product+warehouse. Never store a mutable stock counter.
model InventoryMovement {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  // quantity in salesUnit, signed: + inbound, − outbound. Reservations do NOT
  // create movements (they are tracked in InventoryReservation).
  quantity    Float
  type        String // see MOVEMENT_TYPES
  reference   String? // e.g. PO-0007, ORD-0042, COUNT-0003
  note        String?
  actorId     String?
  actorName   String?
  createdAt   DateTime  @default(now())

  @@index([productId, warehouseId])
  @@index([type, createdAt])
}

model InventoryReservation {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String
  quantity    Float // salesUnit, always positive
  orderId     String?
  orderLineId String?
  createdAt   DateTime @default(now())

  @@index([productId, warehouseId])
  @@index([orderId])
}

model StockCount {
  id          String   @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  code        String
  status      String   @default("OPEN") // OPEN | POSTED | CANCELLED
  createdById String?
