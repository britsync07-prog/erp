}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId  String
  amountCents Int
  method      String   @default("BANK_TRANSFER")
  paidAt      DateTime @default(now())
  reference   String?
  createdById String?
}

model CreditNote {
  id            String   @id @default(cuid())
  number        String
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  returnId      String? // originating return, if created from one (one note per return, enforced in service)
  totalCents    Int
  reason        String?
  status        String   @default("DRAFT") // DRAFT | ISSUED | VOID
  createdById   String?
  createdAt     DateTime @default(now())
  lines         CreditNoteLine[]

  @@unique([number])
  @@index([returnId])
}

model CreditNoteLine {
  id             String     @id @default(cuid())
  noteId         String
  note           CreditNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  description    String
  quantity       Float
  unitPriceCents Int
}

// ─── Cross-cutting: notifications, automation, AI, audit ────────────────────

model Notification {
  id        String   @id @default(cuid())
  orgId     String   // tenant scope: broadcasts never leak across organisations
  userId    String? // null = broadcast to role/org
  roleCode  String?
  severity  String   @default("INFO")
  title     String
  body      String?
  link      String? // deep link to the affected record
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orgId, userId, isRead])
}

model AutomationRule {
  id        String  @id @default(cuid())
  orgId     String  @default("demo-org")
  name      String
  trigger   String // e.g. order.confirmed, stock.low, invoice.overdue
  condition String? // JSON expression (evaluated by the rule engine)
  action    String // e.g. create_requirement, notify, escalate
  isEnabled Boolean @default(true)

  @@index([orgId, trigger])
}

model ApprovalRequest {
  id          String    @id @default(cuid())
  orgId       String    @default("demo-org")
  kind        String // PO_APPROVAL | PRICE_OVERRIDE | STOCK_ADJUSTMENT | DISCOUNT
  entityId    String // target record, or "PENDING" when the action applies on approval
  payload     Json? // machine-readable proposal (e.g. adjustment lines) applied on approval
  requestedBy String
  decidedBy   String?
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reason      String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId, status])
  @@index([status])
}

model AIRecommendation {
  id         String   @id @default(cuid())
  orgId      String
  kind       String // REORDER | RISK | MARGIN | SUPPLIER | DAILY_BRIEF | ...
  title      String
  reason     String
  evidence   Json? // record refs + figures backing the recommendation
  actionLink String?
  status     String   @default("OPEN") // OPEN | ACCEPTED | DISMISSED
  createdAt  DateTime @default(now())

  @@index([orgId, status, createdAt])
}

model AIAction {
  id        String   @id @default(cuid())
  orgId     String
  level     String // A_READ | B_DRAFT | C_APPROVAL_REQUIRED | D_RESTRICTED
  tool      String
  input     Json?
  result    Json?
  userId    String?
  status    String   @default("DONE") // DONE | PENDING_APPROVAL | REJECTED | BLOCKED
